  <metadata>
    <name>Boucle du Château de Valkenburg, Vallée aux Orchidées du Gerendal &amp; Schin op Geul</name>
    <desc>Randonnée variée dans les collines de marne jaune autour de Valkenburg, longeant la rivière Geul, le château de Schaloen et le vallon fleuri du Gerendal.</desc>
    <country>NL</country>
    <region>Zuid-Limburg, Maastricht &amp; Heuvelland (NL)</region>
    <gain>220</gain>
    <carfree>93</carfree>
    <surface>Sentiers de berge &amp; coteaux de marne</surface>
    <tags>water,forest,low_traffic</tags>
    <link href="https://www.visitzuidlimburg.nl">
      <text>Visit Zuid-Limburg (Valkenburg)</text>
    </link>
  </metadata>
