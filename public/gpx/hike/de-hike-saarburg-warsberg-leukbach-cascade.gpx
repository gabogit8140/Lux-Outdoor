  <metadata>
    <name>Boucle du Château de Saarburg, Grande Cascade Urbaine &amp; Vignobles du Warsberg</name>
    <desc>Randonnée variée partant de la cascade de 20 mètres au cœur de Saarburg, montant par les vignes vers le Warsberg et revenant par la vallée du Leukbach.</desc>
    <country>DE</country>
    <region>Sarre, Saarschleife &amp; Hunsrück (DE)</region>
    <gain>245</gain>
    <carfree>90</carfree>
    <surface>Sentiers viticoles &amp; chemins forestiers</surface>
    <tags>water,forest,low_traffic</tags>
    <link href="https://www.saar-obermosel.de">
      <text>Saar-Obermosel Touristik</text>
    </link>
  </metadata>
